{
  "name": "helpdesk-1c",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "backend",
    "connector",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev --workspace backend\" \"npm run dev --workspace frontend\"",
    "dev:backend": "npm run dev --workspace backend",
    "dev:frontend": "npm run dev --workspace frontend",
    "dev:connector": "npm run dev --workspace connector",
    "build": "npm run build --workspace frontend",
    "seed:demo": "npm run seed:demo --workspace backend",
    "start": "npm run start --workspace backend",
    "install:all": "npm install",
    "test": "npm run test --workspace backend && npm run test --workspace frontend && npm run test --workspace connector",
    "smoke": "npm test"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  },
  "engines": {
    "node": ">=24"
  }
}
